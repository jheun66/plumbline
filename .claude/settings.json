{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/lead/session_start.py\" 1" },
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/lead/session_start.py\" 2" },
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/lead/session_start.py\" 3" },
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/lead/session_start.py\" 4" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/connectors/gap_guard_hook.py\"" }
        ]
      },
      {
        "matcher": "Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/connectors/role_guard_hook.py\"" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -B \"$CLAUDE_PROJECT_DIR/.plumbline/connectors/end_of_turn_hook.py\"" }
        ]
      }
    ]
  }
}
